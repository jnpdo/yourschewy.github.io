          <div class="keyword-box-title">Themes & keywords</div>
          <div class="keyword-row">
            <span class="kw filled">Gái Mới</span>
            <span class="kw rust">Colonial femininity</span>
            <span class="kw sage">Vietnamese press</span>
            <span class="kw">Visual culture</span>
            <span class="kw">Fashion & the body</span>
            <span class="kw">Anti-colonial resistance</span>
